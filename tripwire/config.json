{
  "marker": "<!-- e2e-tripwire -->",
  "header": "# E2E Tripwire",
  "botLogin": "github-actions[bot]",
  "e2eRepo": "PassEntry/passentry-e2e",
  "waitSeconds": 120,
  "maxChangedLines": 5000,
  "diffExcludes": [
    "package-lock.json",
    "*.snap",
    "*.lock",
    "dist/**",
    ".env*"
  ],
  "claude": {
    "codeVersion": "2.1.304",
    "model": "claude-sonnet-5-5",
    "effort": "medium",
    "maxTurns": 40,
    "allowedTools": "Read,Grep,Glob,Bash(git show:*)",
    "disallowedTools": "Read(**/.git/**)"
  }
}
